<!DOCTYPE html>
<html lang="no">
<head>
<meta charset="UTF-8">
<title>Set Sail - Søkeområde-diagnose</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
*{box-sizing:border-box}
body{margin:0;font-family:'Segoe UI',system-ui,sans-serif;background:#f3f5f7;color:#1c2733}
header{background:#0b3d66;color:#fff;padding:8px 14px}
header h1{font-size:15px;margin:0}
header p{font-size:11px;margin:3px 0 0;color:#a5c8e5}
.layout{display:grid;grid-template-columns:1fr 340px;gap:8px;height:calc(100vh - 52px);padding:8px}
#map{width:100%;height:100%;border-radius:8px;box-shadow:0 2px 6px rgba(0,0,0,.15);background:#cfd8dc}
.side{display:flex;flex-direction:column;gap:8px;overflow-y:auto}
.card{background:#fff;border-radius:8px;padding:10px;box-shadow:0 2px 6px rgba(0,0,0,.08)}
.card h2{font-size:11px;margin:0 0 7px;color:#0b3d66;text-transform:uppercase;letter-spacing:.5px}
.row{display:flex;gap:6px;align-items:center;margin-bottom:5px}
.row label{flex:0 0 105px;font-size:11px;color:#555}
input,select{padding:4px;border:1px solid #ccc;border-radius:3px;font-size:12px;width:100%}
button{background:#0b3d66;color:#fff;border:none;padding:6px 11px;border-radius:4px;cursor:pointer;font-size:12px;margin:2px 2px 2px 0}
button.sec{background:#6c757d}
button:hover{opacity:.9}
table{width:100%;border-collapse:collapse;font-size:11px}
td{padding:3px 2px;border-bottom:1px solid #eee}
td:first-child{color:#555}
td:last-child{text-align:right;font-weight:bold;font-family:monospace}
.legend{font-size:11px;line-height:1.9}
.sw{display:inline-block;width:22px;height:3px;vertical-align:middle;margin-right:6px}
.note{font-size:11px;background:#fff3cd;color:#856404;padding:7px;border-radius:4px;line-height:1.5}
.bad{color:#c92a2a;font-weight:bold}
.ok{color:#2b8a3e;font-weight:bold}
.hint{font-size:10px;color:#888;margin-top:3px}
</style>
</head>
<body>
<header>
<h1>🔍 Søkeområde-diagnose</h1>
<p>Viser nøyaktig hvilket område ruteplanleggeren faktisk undersøker</p>
</header>

<div class="layout">
<div id="map"></div>
<div class="side">

<div class="card">
<h2>Punkter</h2>
<div class="row"><label>Fra (lat, lon)</label><input id="p1" value="63.278, 8.093"></div>
<div class="row"><label>Til (lat, lon)</label><input id="p2" value="63.128, 8.318"></div>
<button onclick="tegn()">Tegn på nytt</button>
<button class="sec" onclick="settModus('p1')">Sett Fra i kart</button>
<button class="sec" onclick="settModus('p2')">Sett Til i kart</button>
<div class="hint" id="klikkHint">Klikk en knapp, så klikk i kartet.</div>
</div>

<div class="card">
<h2>Oppløsning</h2>
<div class="row"><label>Innstilling</label>
<select id="resN" onchange="tegn()">
<option value="35">Grov (35)</option>
<option value="55" selected>Middels (55)</option>
<option value="80">Fin (80)</option>
</select></div>
<div class="row"><label>Klaring</label>
<select id="margin" onchange="tegn()">
<option value="0">Ingen</option>
<option value="50">50 m</option>
<option value="100" selected>100 m</option>
<option value="250">250 m</option>
<option value="500">500 m</option>
</select></div>
</div>

<div class="card">
<h2>Dagens søkeboks</h2>
<table id="tall"></table>
</div>

<div class="card">
<h2>Forklaring</h2>
<div class="legend">
<span class="sw" style="background:#c92a2a"></span>Luftlinje Fra–Til<br>
<span class="sw" style="background:#1c7ed6"></span>Dagens boks (pad 0,5×)<br>
<span class="sw" style="background:#2b8a3e;border-top:2px dashed #2b8a3e"></span>Med pad 1,0×<br>
<span class="sw" style="background:#f59f00;border-top:2px dashed #f59f00"></span>Med pad 1,5×<br>
<span class="sw" style="background:rgba(114,72,232,.5)"></span>Én rutenettcelle
</div>
</div>

<div class="card">
<h2>Vurdering</h2>
<div class="note" id="vurdering"></div>
</div>

</div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
function hav(la1,lo1,la2,lo2){
  var R=3440.065, r=function(d){return d*Math.PI/180;};
  var dLa=r(la2-la1), dLo=r(lo2-lo1);
  var a=Math.pow(Math.sin(dLa/2),2)+Math.cos(r(la1))*Math.cos(r(la2))*Math.pow(Math.sin(dLo/2),2);
  return 2*R*Math.asin(Math.sqrt(a));
}
function parsePkt(s){
  var d=String(s).split(',');
  return [parseFloat(d[0]), parseFloat(d[1])];
}

var kv = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/sjokartraster/default/webmercator/{z}/{y}/{x}.png',
  {attribution:'Kartverket', maxZoom:18});
var map = L.map('map',{center:[63.2,8.2], zoom:10, layers:[kv]});

var lag = L.layerGroup().addTo(map);
var klikkModus = null;

function settModus(hvem){
  klikkModus = hvem;
  document.getElementById('klikkHint').textContent =
    'Klikk i kartet for å sette ' + (hvem==='p1'?'Fra':'Til') + '...';
}
map.on('click', function(e){
  if(!klikkModus) return;
  document.getElementById(klikkModus).value =
    e.latlng.lat.toFixed(4) + ', ' + e.latlng.lng.toFixed(4);
  klikkModus = null;
  document.getElementById('klikkHint').textContent = 'Klikk en knapp, så klikk i kartet.';
  tegn();
});

// Nøyaktig samme formel som i autoPlanRoute()
function byggBoks(A, B, padFaktor){
  var direct = hav(A[0],A[1],B[0],B[1]);
  var padNM = Math.max(1.5, direct*padFaktor);
  var midLat = (A[0]+B[0])/2;
  var padLat = padNM/60;
  var padLon = padNM/(60*Math.max(0.2, Math.cos(midLat*Math.PI/180)));
  var minLat = Math.min(A[0],B[0])-padLat, maxLat = Math.max(A[0],B[0])+padLat;
  var minLon = Math.min(A[1],B[1])-padLon, maxLon = Math.max(A[1],B[1])+padLon;
  return {
    direct: direct, padNM: padNM,
    minLat:minLat, maxLat:maxLat, minLon:minLon, maxLon:maxLon,
    bredde: hav(midLat,minLon,midLat,maxLon),
    hoyde:  hav(minLat,(minLon+maxLon)/2,maxLat,(minLon+maxLon)/2)
  };
}

function tegn(){
  lag.clearLayers();
  var A = parsePkt(document.getElementById('p1').value);
  var B = parsePkt(document.getElementById('p2').value);
  if(isNaN(A[0])||isNaN(A[1])||isNaN(B[0])||isNaN(B[1])) return;

  var resN = parseInt(document.getElementById('resN').value);
  var marginM = parseFloat(document.getElementById('margin').value);

  var b05 = byggBoks(A,B,0.5);
  var b10 = byggBoks(A,B,1.0);
  var b15 = byggBoks(A,B,1.5);

  // Større bokser først, så de ligger bakerst
  L.rectangle([[b15.minLat,b15.minLon],[b15.maxLat,b15.maxLon]],
    {color:'#f59f00', weight:2, dashArray:'8,6', fill:false})
    .bindTooltip('Pad 1,5× — '+b15.bredde.toFixed(1)+' × '+b15.hoyde.toFixed(1)+' NM').addTo(lag);

  L.rectangle([[b10.minLat,b10.minLon],[b10.maxLat,b10.maxLon]],
    {color:'#2b8a3e', weight:2, dashArray:'8,6', fill:false})
    .bindTooltip('Pad 1,0× — '+b10.bredde.toFixed(1)+' × '+b10.hoyde.toFixed(1)+' NM').addTo(lag);

  L.rectangle([[b05.minLat,b05.minLon],[b05.maxLat,b05.maxLon]],
    {color:'#1c7ed6', weight:3, fillColor:'#1c7ed6', fillOpacity:0.07})
    .bindTooltip('<b>DAGENS BOKS</b><br>'+b05.bredde.toFixed(1)+' × '+b05.hoyde.toFixed(1)+' NM', {sticky:true}).addTo(lag);

  L.polyline([A,B],{color:'#c92a2a', weight:3}).addTo(lag);
  L.marker(A).bindTooltip('Fra',{permanent:true,direction:'top'}).addTo(lag);
  L.marker(B).bindTooltip('Til',{permanent:true,direction:'top'}).addTo(lag);

  // Én rutenettcelle, tegnet midt i boksen for størrelsesfølelse
  var cellNM = Math.max(b05.bredde,b05.hoyde)/resN;
  var cellLat = cellNM/60;
  var cellLon = cellNM/(60*Math.cos(((A[0]+B[0])/2)*Math.PI/180));
  var cLa = (b05.minLat+b05.maxLat)/2, cLo = (b05.minLon+b05.maxLon)/2;
  L.rectangle([[cLa,cLo],[cLa+cellLat,cLo+cellLon]],
    {color:'#7048e8', weight:2, fillColor:'#7048e8', fillOpacity:0.45})
    .bindTooltip('Én celle: '+(cellNM*1852).toFixed(0)+' m', {sticky:true}).addTo(lag);

  // Effektiv sperrebredde: cellen pluss klaring på begge sider
  var effektivM = cellNM*1852 + 2*marginM;

  document.getElementById('tall').innerHTML =
    '<tr><td>Luftlinje</td><td>'+b05.direct.toFixed(2)+' NM</td></tr>'+
    '<tr><td>Polstring (0,5×)</td><td>'+b05.padNM.toFixed(2)+' NM</td></tr>'+
    '<tr><td>Boks bredde</td><td>'+b05.bredde.toFixed(1)+' NM</td></tr>'+
    '<tr><td>Boks høyde</td><td>'+b05.hoyde.toFixed(1)+' NM</td></tr>'+
    '<tr><td>Vestkant</td><td>'+b05.minLon.toFixed(3)+'° E</td></tr>'+
    '<tr><td>Østkant</td><td>'+b05.maxLon.toFixed(3)+'° E</td></tr>'+
    '<tr><td>Sørkant</td><td>'+b05.minLat.toFixed(3)+'° N</td></tr>'+
    '<tr><td>Nordkant</td><td>'+b05.maxLat.toFixed(3)+'° N</td></tr>'+
    '<tr><td>Rutenett</td><td>'+Math.round(b05.bredde/cellNM)+' × '+Math.round(b05.hoyde/cellNM)+'</td></tr>'+
    '<tr><td>Cellestørrelse</td><td>'+(cellNM*1852).toFixed(0)+' m</td></tr>'+
    '<tr><td>+ klaring beggeveis</td><td>'+effektivM.toFixed(0)+' m</td></tr>';

  var v = '';
  if(effektivM > 800){
    v += '<span class="bad">Sund smalere enn ca. '+effektivM.toFixed(0)+' m blir sperret</span> '+
         'fordi cellen pluss klaringen dekker hele passasjen. Prøv finere oppløsning '+
         'og/eller mindre klaring.<br><br>';
  } else {
    v += '<span class="ok">Cellestørrelsen tåler sund ned mot ca. '+effektivM.toFixed(0)+' m.</span><br><br>';
  }
  v += 'Ligger en nødvendig passasje <b>utenfor den blå boksen</b>, blir den aldri vurdert — '+
       'uansett oppløsning. Sammenlign blå boks med hvor omveien faktisk må gå.';
  document.getElementById('vurdering').innerHTML = v;

  map.fitBounds([[b10.minLat,b10.minLon],[b10.maxLat,b10.maxLon]], {padding:[20,20]});
}

tegn();
</script>
</body>
</html>
